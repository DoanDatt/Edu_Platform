generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  // partialIndexes: cho phép @@unique(..., where: ...) = unique chỉ áp dụng cho dòng chưa xóa mềm
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int        @id @default(autoincrement())
  email       String     @unique
  name        String     @db.VarChar(500)
  password    String     @db.VarChar(500)
  phoneNumber String     @db.VarChar(50)
  avatar      String?    @db.VarChar(1000)
  // Dùng cho đăng nhập 2 bước (2FA)
  totpSecret  String?    @unique @db.VarChar(1000)
  status      UserStatus @default(INACTIVE)

  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  refreshTokens      RefreshToken[]
  createdPermissions Permission[]   @relation("PermissionCreatedBy")
  updatedPermissions Permission[]   @relation("PermissionUpdatedBy")
  createdRoles       Role[]         @relation("RoleCreatedBy")
  updatedRoles       Role[]         @relation("RoleUpdatedBy")

  // Tự quan hệ 1-n: 1 user (admin) có thể tạo ra nhiều user khác
  createdById  Int?
  createdBy    User?  @relation("CreatorUsers", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdUsers User[] @relation("CreatorUsers")
  updatedById  Int?
  updatedBy    User?  @relation("UpdatorUsers", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedUsers User[] @relation("UpdatorUsers")

  // Khóa học do user này dạy (role INSTRUCTOR)
  courses           Course[]
  createdCategories Category[] @relation("CategoryCreatedBy")
  updatedCategories Category[] @relation("CategoryUpdatedBy")

  // Học viên: khóa đã ghi danh + bài đã học xong
  enrollments       Enrollment[]
  lectureProgresses LectureProgress[]
  lectureWatches    LectureWatch[]
  quizAttempts      QuizAttempt[]
  reviews           Review[]
  // Thông báo trong web (chuông ở header) gửi tới user này
  notifications     Notification[]
  // Đơn mua khóa học có phí
  orders            Order[]
  // Bình luận dưới trang chi tiết khóa học (khi đang đăng nhập)
  courseComments    CourseComment[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model VerificationCode {
  id       Int                  @id @default(autoincrement())
  email    String               @unique @db.VarChar(500)
  // Lưu HASH của mã OTP (sha256, 64 ký tự), không lưu mã gốc: lộ DB cũng không dùng được mã
  code     String               @db.VarChar(100)
  type     VerificationCodeType
  // Số lần nhập sai. Quá giới hạn thì mã bị hủy, chống đoán mò 6 chữ số
  attempts Int                  @default(0)

  expiresAt DateTime
  // Lúc gửi mã gần nhất (dùng để giới hạn: 60 giây mới được gửi lại)
  createdAt DateTime @default(now())

  @@index([email, code, type])
  @@index([expiresAt])
}

model RefreshToken {
  token  String @unique @db.VarChar(1000)
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Permission {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(500)
  description String     @default("")
  path        String     @db.VarChar(1000)
  method      HTTPMethod
  roles       Role[]

  createdById Int?
  createdBy   User? @relation("PermissionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("PermissionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Không có 2 permission ĐANG HOẠT ĐỘNG trùng method + path (dòng đã xóa mềm thì không tính).
  // DB tự chặn → 2 request tạo cùng lúc cũng không lọt
  @@unique([method, path], where: { deletedAt: null })
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(500)
  description String       @default("")
  isActive    Boolean      @default(true)
  permissions Permission[]
  users       User[]

  createdById Int?
  createdBy   User? @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("RoleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Tên role (luôn IN HOA) không trùng trong các role đang hoạt động
  @@unique([name], where: { deletedAt: null })
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(200)
  description String   @default("")
  courses     Course[]

  createdById Int?
  createdBy   User? @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("CategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Tên danh mục không trùng trong các danh mục đang hoạt động.
  // Index phân biệt hoa thường; trùng kiểu "web" / "Web" vẫn do service chặn (so sánh insensitive)
  @@unique([name], where: { deletedAt: null })
}

model Course {
  id           Int          @id @default(autoincrement())
  title        String       @db.VarChar(300)
  subtitle     String       @default("") @db.VarChar(500)
  // Mô tả chi tiết có thể rất dài → không giới hạn VarChar
  description  String       @default("")
  thumbnail    String?      @db.VarChar(1000)
  // Giá tính bằng VND (số nguyên, không có số lẻ). 0 = miễn phí
  price        Int          @default(0)
  level        CourseLevel  @default(ALL_LEVELS)
  language     String       @default("vi") @db.VarChar(10)
  status       CourseStatus @default(DRAFT)
  // Admin từ chối thì ghi lý do để giảng viên biết mà sửa
  rejectReason String?      @db.VarChar(1000)
  publishedAt  DateTime?

  instructorId Int
  // NoAction: còn khoá học thì không cho xoá thật giảng viên / danh mục
  instructor   User     @relation(fields: [instructorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoryId   Int
  category     Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Mục lục: khóa học → chương → bài giảng
  sections    Section[]
  enrollments Enrollment[]
  reviews     Review[]
  orders      Order[]
  // Bình luận công khai dưới trang chi tiết (khác đánh giá: không cần ghi danh, không chấm sao)
  comments    CourseComment[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, deletedAt])
  @@index([instructorId])
  @@index([categoryId])
}

// Chương trong khóa học
model Section {
  id       Int    @id @default(autoincrement())
  title    String @db.VarChar(300)
  // Thứ tự hiển thị trong khóa học (nhỏ đứng trước)
  position Int    @default(0)

  courseId Int
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lectures Lecture[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([courseId, position])
}

// Bài giảng trong chương
model Lecture {
  id          Int     @id @default(autoincrement())
  title       String  @db.VarChar(300)
  // Tạm thời là URL video có sẵn (YouTube, mp4...); phần upload làm sau
  videoUrl    String? @db.VarChar(1000)
  // Nội dung bài viết / ghi chú kèm video
  content     String  @default("")
  durationSec Int     @default(0)
  // true = cho xem thử miễn phí, không cần ghi danh
  isPreview   Boolean @default(false)
  // Thứ tự trong chương (nhỏ đứng trước)
  position    Int     @default(0)

  sectionId Int
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  progresses    LectureProgress[]
  watches       LectureWatch[]
  quizQuestions QuizQuestion[]
  quizAttempts  QuizAttempt[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([sectionId, position])
}

// Học viên ghi danh khóa học
model Enrollment {
  id Int @id @default(autoincrement())

  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  createdAt DateTime @default(now())

  // Mỗi người chỉ ghi danh 1 khóa đúng 1 lần (DB tự chặn trùng)
  @@unique([userId, courseId])
  @@index([courseId])
}

// Bài giảng học viên đã học xong (có dòng = đã xong, không có = chưa)
model LectureProgress {
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lectureId Int
  lecture   Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  completedAt DateTime @default(now())

  // Khóa chính gồm 2 cột: 1 người + 1 bài chỉ có 1 dòng
  @@id([userId, lectureId])
  @@index([lectureId])
}

// Học viên đã xem video của 1 bài được bao lâu. Xem đủ 90% thời lượng → tự tính là học xong (LectureProgress)
model LectureWatch {
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lectureId Int
  lecture   Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Tổng số giây video THỰC SỰ phát (tua qua không tính). Tối đa = thời lượng bài
  watchedSec  Int      @default(0)
  // Giây đang dừng → lần sau mở bài xem tiếp từ đây
  positionSec Int      @default(0)
  // Lần báo gần nhất: số giây được cộng thêm không vượt quá thời gian thực đã trôi qua (chống gửi số giả)
  reportedAt  DateTime @default(now())

  @@id([userId, lectureId])
  @@index([lectureId])
}

// Câu hỏi trắc nghiệm cuối bài giảng (1 đáp án đúng). Bài có câu hỏi = bài có quiz
model QuizQuestion {
  id           Int      @id @default(autoincrement())
  lectureId    Int
  lecture      Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  question     String   @db.VarChar(1000)
  // 2–6 lựa chọn, đáp án đúng là options[correctIndex]
  options      String[]
  correctIndex Int
  // Giải thích hiện sau khi nộp bài
  explanation  String   @default("")
  position     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lectureId, position])
}

// Mỗi lần học viên nộp quiz của 1 bài. Làm lại không giới hạn, giữ lại lịch sử
model QuizAttempt {
  id        Int     @id @default(autoincrement())
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lectureId Int
  lecture   Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Điểm theo % (0–100), đạt khi >= QUIZ_PASS_PERCENT
  score         Int
  correctCount  Int
  totalQuestion Int
  passed        Boolean
  // Đáp án đã chọn theo thứ tự câu hỏi lúc nộp: [{ questionId, selectedIndex }]
  answers       Json

  createdAt DateTime @default(now())

  @@index([userId, lectureId])
  @@index([lectureId])
}

// Đánh giá khóa học của học viên đã ghi danh
model Review {
  id      Int    @id @default(autoincrement())
  // 1 → 5 sao (kiểm tra ở Zod)
  rating  Int
  comment String @default("")

  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Mỗi người đánh giá 1 khóa đúng 1 lần (muốn đổi thì sửa đánh giá cũ).
  // Đánh giá xóa thật (không xóa mềm) để xóa xong còn viết lại được
  @@unique([userId, courseId])
  @@index([courseId, createdAt])
}

// Thông báo trong web: chuông ở header, có số chưa đọc. Tạo kèm các sự kiện (khóa được duyệt / bị từ chối,
// có học viên ghi danh...). Chỉ là bản ghi để hiển thị: tạo lỗi thì bỏ qua, không làm hỏng thao tác chính
model Notification {
  id      Int              @id @default(autoincrement())
  userId  Int
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  type    NotificationType
  title   String           @db.VarChar(300)
  message String           @db.VarChar(1000)
  // Đường dẫn trang frontend mở ra khi bấm vào thông báo (ví dụ /instructor/courses/15)
  link    String?          @db.VarChar(500)
  // null = chưa đọc
  readAt  DateTime?

  createdAt DateTime @default(now())

  // Danh sách thông báo của 1 người, mới nhất trước
  @@index([userId, createdAt])
  // Đếm số chưa đọc (readAt IS NULL) của 1 người
  @@index([userId, readAt])
}

// Đơn mua 1 khóa học có phí. Thanh toán thành công → tự ghi danh khóa đó
model Order {
  id       Int    @id @default(autoincrement())
  // Mã đơn ngắn, duy nhất (EDU + 8 ký tự). Dùng làm: nội dung chuyển khoản SePay, orderId gửi MoMo,
  // custom_id gửi PayPal → cổng báo về là biết đơn nào
  code     String @unique @db.VarChar(30)
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Giá CHỐT lúc tạo đơn (VND). Sau này khóa đổi giá thì đơn cũ vẫn giữ đúng số tiền đã báo cho người mua
  amount      Int
  status      OrderStatus    @default(PENDING)
  // Cổng thanh toán người mua chọn ở trang thanh toán (chưa chọn → null)
  method      PaymentMethod?
  // Mã giao dịch phía cổng: MoMo transId, PayPal order id, SePay transaction id (để đối soát)
  providerRef String?        @db.VarChar(200)
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Lịch sử mua hàng của 1 người, mới nhất trước
  @@index([userId, createdAt])
  // Thống kê doanh thu: các đơn đã thanh toán theo thời gian
  @@index([status, paidAt])
  @@index([courseId])
}

// Mỗi lần cổng thanh toán gọi về (MoMo IPN, SePay webhook, PayPal capture) ghi 1 dòng.
// unique(method, externalId): cổng gửi lại cùng 1 giao dịch nhiều lần → chỉ xử lý lần đầu
model PaymentLog {
  id         Int           @id @default(autoincrement())
  method     PaymentMethod
  // Mã giao dịch phía cổng (MoMo transId, SePay id, PayPal capture id)
  externalId String        @db.VarChar(200)
  // Đơn khớp được (null: không tìm thấy đơn, ví dụ nội dung chuyển khoản sai mã)
  orderId    Int?
  // Dữ liệu gốc cổng gửi về, giữ lại để tra cứu khi có khiếu nại
  payload    Json

  createdAt DateTime @default(now())

  @@unique([method, externalId])
  @@index([orderId])
}

// Bình luận dưới trang chi tiết khóa học (form "Leave a comment" của EduPress).
// Khách cũng bình luận được: nhập tên + email. Đang đăng nhập thì gắn userId (tên / email lấy từ tài khoản).
// Email chỉ để liên hệ, KHÔNG trả ra API công khai
model CourseComment {
  id       Int    @id @default(autoincrement())
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userId   Int?
  user     User?  @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  name    String @db.VarChar(100)
  email   String @db.VarChar(200)
  content String @db.VarChar(2000)

  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([courseId, createdAt])
}

// Tin nhắn gửi từ trang Liên hệ. Lưu lại để không mất khi email lỗi; admin nhận thêm 1 email báo
model ContactMessage {
  id      Int    @id @default(autoincrement())
  name    String @db.VarChar(100)
  email   String @db.VarChar(200)
  message String @db.VarChar(5000)

  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum OrderStatus {
  PENDING // chờ thanh toán
  PAID // đã thanh toán (đã ghi danh)
  CANCELLED // người mua hủy, hoặc quá hạn không thanh toán
}

enum PaymentMethod {
  MOMO
  PAYPAL
  SEPAY
}

enum NotificationType {
  COURSE_SUBMITTED // giảng viên gửi duyệt → admin
  COURSE_APPROVED // admin duyệt → giảng viên
  COURSE_REJECTED // admin từ chối → giảng viên
  COURSE_UNPUBLISHED // admin gỡ khóa đang công khai → giảng viên
  NEW_ENROLLMENT // học viên ghi danh → giảng viên
  NEW_REVIEW // học viên đánh giá → giảng viên
  NEW_ORDER // có người mua khóa (thanh toán thành công) → giảng viên
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum CourseStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum VerificationCodeType {
  REGISTER
  FORGOT_PASSWORD
}

enum HTTPMethod {
  GET
  POST
  PUT
  DELETE
  PATCH
  OPTIONS
  HEAD
}
