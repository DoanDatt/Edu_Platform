generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int        @id @default(autoincrement())
  email       String     @unique
  name        String     @db.VarChar(500)
  password    String     @db.VarChar(500)
  phoneNumber String     @db.VarChar(50)
  avatar      String?    @db.VarChar(1000)
  // Dùng cho đăng nhập 2 bước (2FA)
  totpSecret  String?    @unique @db.VarChar(1000)
  status      UserStatus @default(INACTIVE)

  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  refreshTokens      RefreshToken[]
  createdPermissions Permission[]   @relation("PermissionCreatedBy")
  updatedPermissions Permission[]   @relation("PermissionUpdatedBy")
  createdRoles       Role[]         @relation("RoleCreatedBy")
  updatedRoles       Role[]         @relation("RoleUpdatedBy")

  // Tự quan hệ 1-n: 1 user (admin) có thể tạo ra nhiều user khác
  createdById  Int?
  createdBy    User?  @relation("CreatorUsers", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdUsers User[] @relation("CreatorUsers")
  updatedById  Int?
  updatedBy    User?  @relation("UpdatorUsers", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedUsers User[] @relation("UpdatorUsers")

  // Khóa học do user này dạy (role INSTRUCTOR)
  courses           Course[]
  createdCategories Category[] @relation("CategoryCreatedBy")
  updatedCategories Category[] @relation("CategoryUpdatedBy")

  // Học viên: khóa đã ghi danh + bài đã học xong
  enrollments       Enrollment[]
  lectureProgresses LectureProgress[]
  reviews           Review[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model VerificationCode {
  id       Int                  @id @default(autoincrement())
  email    String               @unique @db.VarChar(500)
  // Lưu HASH của mã OTP (sha256, 64 ký tự), không lưu mã gốc: lộ DB cũng không dùng được mã
  code     String               @db.VarChar(100)
  type     VerificationCodeType
  // Số lần nhập sai. Quá giới hạn thì mã bị hủy, chống đoán mò 6 chữ số
  attempts Int                  @default(0)

  expiresAt DateTime
  // Lúc gửi mã gần nhất (dùng để giới hạn: 60 giây mới được gửi lại)
  createdAt DateTime @default(now())

  @@index([email, code, type])
  @@index([expiresAt])
}

model RefreshToken {
  token  String @unique @db.VarChar(1000)
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Permission {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(500)
  description String     @default("")
  path        String     @db.VarChar(1000)
  method      HTTPMethod
  roles       Role[]

  createdById Int?
  createdBy   User? @relation("PermissionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("PermissionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(500)
  description String       @default("")
  isActive    Boolean      @default(true)
  permissions Permission[]
  users       User[]

  createdById Int?
  createdBy   User? @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("RoleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(200)
  description String   @default("")
  courses     Course[]

  createdById Int?
  createdBy   User? @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  updatedById Int?
  updatedBy   User? @relation("CategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Course {
  id           Int          @id @default(autoincrement())
  title        String       @db.VarChar(300)
  subtitle     String       @default("") @db.VarChar(500)
  // Mô tả chi tiết có thể rất dài → không giới hạn VarChar
  description  String       @default("")
  thumbnail    String?      @db.VarChar(1000)
  // Giá tính bằng VND (số nguyên, không có số lẻ). 0 = miễn phí
  price        Int          @default(0)
  level        CourseLevel  @default(ALL_LEVELS)
  language     String       @default("vi") @db.VarChar(10)
  status       CourseStatus @default(DRAFT)
  // Admin từ chối thì ghi lý do để giảng viên biết mà sửa
  rejectReason String?      @db.VarChar(1000)
  publishedAt  DateTime?

  instructorId Int
  // NoAction: còn khoá học thì không cho xoá thật giảng viên / danh mục
  instructor   User     @relation(fields: [instructorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoryId   Int
  category     Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Mục lục: khóa học → chương → bài giảng
  sections    Section[]
  enrollments Enrollment[]
  reviews     Review[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, deletedAt])
  @@index([instructorId])
  @@index([categoryId])
}

// Chương trong khóa học
model Section {
  id       Int    @id @default(autoincrement())
  title    String @db.VarChar(300)
  // Thứ tự hiển thị trong khóa học (nhỏ đứng trước)
  position Int    @default(0)

  courseId Int
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lectures Lecture[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([courseId, position])
}

// Bài giảng trong chương
model Lecture {
  id          Int     @id @default(autoincrement())
  title       String  @db.VarChar(300)
  // Tạm thời là URL video có sẵn (YouTube, mp4...); phần upload làm sau
  videoUrl    String? @db.VarChar(1000)
  // Nội dung bài viết / ghi chú kèm video
  content     String  @default("")
  durationSec Int     @default(0)
  // true = cho xem thử miễn phí, không cần ghi danh
  isPreview   Boolean @default(false)
  // Thứ tự trong chương (nhỏ đứng trước)
  position    Int     @default(0)

  sectionId Int
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  progresses LectureProgress[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([sectionId, position])
}

// Học viên ghi danh khóa học
model Enrollment {
  id Int @id @default(autoincrement())

  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  createdAt DateTime @default(now())

  // Mỗi người chỉ ghi danh 1 khóa đúng 1 lần (DB tự chặn trùng)
  @@unique([userId, courseId])
  @@index([courseId])
}

// Bài giảng học viên đã học xong (có dòng = đã xong, không có = chưa)
model LectureProgress {
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lectureId Int
  lecture   Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  completedAt DateTime @default(now())

  // Khóa chính gồm 2 cột: 1 người + 1 bài chỉ có 1 dòng
  @@id([userId, lectureId])
  @@index([lectureId])
}

// Đánh giá khóa học của học viên đã ghi danh
model Review {
  id      Int    @id @default(autoincrement())
  // 1 → 5 sao (kiểm tra ở Zod)
  rating  Int
  comment String @default("")

  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Mỗi người đánh giá 1 khóa đúng 1 lần (muốn đổi thì sửa đánh giá cũ).
  // Đánh giá xóa thật (không xóa mềm) để xóa xong còn viết lại được
  @@unique([userId, courseId])
  @@index([courseId, createdAt])
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum CourseStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum VerificationCodeType {
  REGISTER
  FORGOT_PASSWORD
}

enum HTTPMethod {
  GET
  POST
  PUT
  DELETE
  PATCH
  OPTIONS
  HEAD
}
