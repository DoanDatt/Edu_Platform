POSTGRES_USER=edu
POSTGRES_PASSWORD=edu_secret
POSTGRES_DB=edu_platform
POSTGRES_PORT=5432

PORT=4000
# Frontend được phép gọi API (cách nhau bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL="postgresql://edu:edu_secret@localhost:5432/edu_platform?schema=public"

# Tạo secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=change_me
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_me_too
REFRESH_TOKEN_EXPIRES_IN=7d

ADMIN_NAME="Admin"
ADMIN_EMAIL=admin@edu.local
ADMIN_PASSWORD=change_me
ADMIN_PHONE_NUMBER=0900000000

# Redis cho hàng đợi BullMQ (docker compose có sẵn)
REDIS_URL=redis://localhost:6379
# true = server chạy luôn worker; false = chạy worker riêng bằng npm run worker
RUN_WORKER=true

# Email: mặc định gửi vào Mailpit (docker compose), xem thư ở http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM="Edu Platform <no-reply@edu.local>"
# Dùng để tạo link trong email
FRONTEND_URL=http://localhost:3000

# Upload: lưu file vào thư mục UPLOAD_DIR, trả về link <PUBLIC_URL>/uploads/...
PUBLIC_URL=http://localhost:4000
UPLOAD_DIR=uploads
MAX_IMAGE_MB=5
MAX_VIDEO_MB=500

# Giới hạn số request cho đăng nhập, đăng ký, quên mật khẩu (false khi chạy test)
RATE_LIMIT_ENABLED=true

# Số proxy đứng trước app khi deploy để đọc đúng IP người dùng (Render: 1). Chạy local: 0
TRUST_PROXY=0

# Cloudinary (tùy chọn): có thì ảnh / video upload lên Cloudinary thay vì ổ đĩa server.
# Bắt buộc khi deploy lên Render (ổ đĩa bị xóa khi khởi động lại). Lấy ở Cloudinary Dashboard → API Keys
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ===== Thanh toán: điền đủ biến của cổng nào thì cổng đó hiện ở trang thanh toán =====
# Tiền tố mã đơn (phải trùng "Cấu trúc mã thanh toán" trên my.sepay.vn)
PAYMENT_CODE_PREFIX=EDU

# MoMo môi trường test: bộ khóa test công khai của MoMo (github.com/momo-wallet/payment).
# IPN gửi về <PUBLIC_URL>/payments/momo/ipn → chạy local thì không nhận được, trang kết quả tự hỏi MoMo bù
# MOMO_PARTNER_CODE=MOMO
# MOMO_ACCESS_KEY=F8BBA842ECF85
# MOMO_SECRET_KEY=K951B6PE1waDMi640xX08PD3vg6EkVlz
# MOMO_ENDPOINT=https://test-payment.momo.vn
# payWithATM: trả bằng thẻ ATM test (9704 0000 0000 0018, NGUYEN VAN A, 03/07, OTP: OTP). captureWallet: quét bằng app MoMo test
# MOMO_REQUEST_TYPE=payWithATM

# PayPal sandbox: developer.paypal.com → Apps & Credentials (Sandbox) → tạo app → Client ID / Secret
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_API=https://api-m.sandbox.paypal.com
# Tỉ giá đổi VND → USD (PayPal không nhận VND)
# PAYPAL_VND_PER_USD=25000

# SePay (tiền thật): my.sepay.vn → Webhooks → thêm webhook, URL <PUBLIC_URL>/payments/sepay/webhook,
# kiểu chứng thực "API Key" → dán key đó vào SEPAY_API_KEY
# SEPAY_API_KEY=
# Ngân hàng nhận tiền: tên viết tắt hoặc mã BIN (vd MBBank, VCB, 970422)
# SEPAY_BANK=
# SEPAY_ACCOUNT_NUMBER=
# SEPAY_ACCOUNT_NAME=

