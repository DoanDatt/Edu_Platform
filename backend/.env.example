# Copy file này thành .env rồi đổi giá trị cho phù hợp:  cp .env.example .env

# --- App ---
NODE_ENV=development
PORT=3000

# --- Postgres (docker-compose.yml đọc các biến này) ---
POSTGRES_USER=edu
POSTGRES_PASSWORD=change_me
POSTGRES_DB=edu_platform
POSTGRES_PORT=5432

# --- Prisma / NestJS ---
# Định dạng: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# USER, PASSWORD, PORT, DATABASE phải khớp với các biến POSTGRES_* ở trên
DATABASE_URL="postgresql://edu:change_me@localhost:5432/edu_platform?schema=public"
