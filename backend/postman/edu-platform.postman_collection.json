{
  "info": {
    "name": "Edu Platform API",
    "description": "Chạy \"Auth / Đăng nhập\" trước: accessToken và refreshToken tự lưu vào biến của collection, các request khác tự gắn header Authorization.\n\nĐổi tài khoản: sửa biến email / password ở tab Variables của collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "email",
      "value": "hocvien1@edu.local"
    },
    {
      "key": "password",
      "value": "Demo@1234"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "courseId",
      "value": "1"
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "sectionId",
      "value": "1"
    },
    {
      "key": "lectureId",
      "value": "1"
