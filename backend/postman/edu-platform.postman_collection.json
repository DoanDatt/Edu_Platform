  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Đăng ký",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hocvienmoi@gmail.com\",\n  \"password\": \"12345678\",\n  \"confirmPassword\": \"12345678\",\n  \"name\": \"Học viên mới\",\n  \"phoneNumber\": \"0901234567\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json()",
                  "if ((pm.response.code === 200 || pm.response.code === 201) && body.data && body.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken)",
                  "  pm.collectionVariables.set('refreshToken', body.data.refreshToken)",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Đăng nhập",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
